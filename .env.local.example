# Copy this file to .env.local and fill in your Supabase project values.
# Dashboard → Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Older projects that predate the publishable key can use the legacy anon key
# instead, from the "Legacy API Keys" tab. Supabase removes these at the end of
# 2026, so prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
